# Add only the integrations/providers you actually use.
# Copy these values into Render Dashboard -> hermes-agent -> Environment.

# LLM provider (example: OpenRouter)
OPENROUTER_API_KEY=

# Daytona SDK (needed only when your tools/scripts use Daytona)
DAYTONA_API_KEY=

# Messaging integration examples (configure the matching platform in Hermes)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
